PRODUCTION=1
PLANE_PRODUCTION=1
SPIFFE_REQUIRED=1
PLANE_ALLOW_CALLER_OVERRIDE=0
PLANE_TRUST_DOMAIN=prod
PLANE_POLICY_VERSION=1
PLANE_PLATFORM=nitro
PLANE_BROKER_MEASUREMENT=sha256:REPLACE_NITRO_PCR0
SPIFFE_ENDPOINT_SOCKET=unix:///run/spire/sockets/agent.sock
FRONT_DOOR_TLS=1
ALLOW_ADMIN_DESTRUCTIVE_ACTIONS=false
K8S_ALLOW_SCALE_ZERO=0
# Delegated capability issuance: pin AVRONE's Ed25519 workload assertion key out of band.
PLANE_DELEGATION_REQUESTER_ID=spiffe://prod/agent/avrone
PLANE_DELEGATION_REQUESTER_PUBLIC_KEY_FILE=/run/secrets/avrone-delegation-requester.pub
PLANE_DELEGATION_ALLOWED_AUDIENCES=spiffe://prod/agent/swarm
PLANE_AVRONE_PARENT_CAPABILITY_FILE=/run/secrets/avrone-swarm-parent-capability.json
PLANE_AVRONE_PARENT_CAPABILITY_CORRELATION_ID=avrone-swarm-root-2026-11-03
PLANE_AVRONE_PARENT_CAPABILITY_TTL_SECONDS=300
